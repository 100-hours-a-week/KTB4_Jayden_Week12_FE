# 이 파일을 .env로 복사한 뒤 로컬 전용 값을 입력하세요.
HTTP_PORT=80

MYSQL_DATABASE=hobbyloop
MYSQL_USER=hobbyloop
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

# HS256 기준 최소 32바이트 이상의 무작위 문자열을 사용하세요.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=180
JWT_REFRESH_TOKEN_EXPIRATION=12096000

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
CORS_ALLOWED_ORIGINS=http://localhost
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
